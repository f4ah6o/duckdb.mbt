// Imports are shared by every target, but several are only reachable from
// target-specific or test-only files (`encoding/utf8` and `math` on native,
// `double` and `json` in js tests, `quickcheck` in the native PBT files), so
// `unused_package` reports false positives per target.
//
// `result_error_return` asks failable APIs to use `T raise E`. This package
// returns `Result[T, DuckDBError]` on purpose: callers match on the error as
// ordinary data (see MIGRATION.md), and the js backend forwards it across the
// FFI boundary, so the error effect is not an option here.
warnings = "-unused_package-result_error_return"

import {
  "moonbitlang/quickcheck" @pbt,
  "moonbitlang/core/quickcheck" @gen,
  "moonbitlang/core/debug",
  "moonbitlang/core/double",
  "moonbitlang/core/encoding/utf8" @encoding/utf8,
  "moonbitlang/core/int",
  "moonbitlang/core/json",
  "moonbitlang/core/math",
}

options(
  "is-main": false,
  link: {
    "native": {
      "cc-link-flags": "-L/opt/homebrew/lib -Wl,-rpath,/opt/homebrew/lib -L/usr/local/lib -Wl,-rpath,/usr/local/lib -L/usr/lib -lduckdb",
      "stub-cc-flags": "-I/opt/homebrew/include -I/usr/local/include -I/usr/include",
      "stub-cc-link-flags": "-L/opt/homebrew/lib -Wl,-rpath,/opt/homebrew/lib -L/usr/local/lib -Wl,-rpath,/usr/local/lib -L/usr/lib -lduckdb",
    },
  },
  "native-stub": [ "duckdb_native.c" ],
  targets: {
    "duckdb_appender_chunk_js.mbt": [ "js" ],
    "duckdb_appender_chunk_js_wbtest.mbt": [ "js" ],
    "duckdb_appender_chunk_native.mbt": [ "native" ],
    "duckdb_appender_chunk_test.mbt": [ "native" ],
    "duckdb_appender_chunk_wbtest.mbt": [ "or", "native", "js" ],
    "duckdb_appender_state_machine.mbt": [ "and", "native", "wasm-gc" ],
    "duckdb_arrow_js.mbt": [ "js" ],
    "duckdb_arrow_js_wbtest.mbt": [ "js" ],
    "duckdb_arrow_native.mbt": [ "native" ],
    "duckdb_arrow_test.mbt": [ "native" ],
    "duckdb_arrow_unsupported.mbt": [ "or", "wasm", "wasm-gc" ],
    "duckdb_blob_pbt_test.mbt": [ "and", "native", "wasm-gc" ],
    "duckdb_capabilities_js_test.mbt": [ "js" ],
    "duckdb_capabilities_test.mbt": [ "native" ],
    "duckdb_capabilities_wbtest.mbt": [ "or", "native", "js" ],
    "duckdb_collection_pbt_test.mbt": [ "and", "native", "wasm-gc" ],
    "duckdb_connection_state_machine.mbt": [ "and", "native", "wasm-gc" ],
    "duckdb_decimal_pbt_test.mbt": [ "and", "native", "wasm-gc" ],
    "duckdb_duckdb2_wbtest.mbt": [ "native" ],
    "duckdb_error_wbtest.mbt": [ "or", "native", "js" ],
    "duckdb_extension_wbtest.mbt": [ "or", "native", "js" ],
    "duckdb_interval_pbt_test.mbt": [ "and", "native", "wasm-gc" ],
    "duckdb_js.mbt": [ "js" ],
    "duckdb_js_wbtest.mbt": [ "js" ],
    "duckdb_native.mbt": [ "native" ],
    "duckdb_native_error_wbtest.mbt": [ "native" ],
    "duckdb_vector_js.mbt": [ "js" ],
    "duckdb_vector_js_wbtest.mbt": [ "js" ],
    "duckdb_vector_native.mbt": [ "native" ],
    "duckdb_vector_test.mbt": [ "native" ],
    "duckdb_pbt_test.mbt": [ "and", "native", "wasm-gc" ],
    "duckdb_quack_wbtest.mbt": [ "or", "native", "js" ],
    "duckdb_test.mbt": [ "native" ],
    "duckdb_unsupported.mbt": [ "or", "wasm", "wasm-gc" ],
    "pbt/generators.mbt": [ "and", "native", "wasm-gc" ],
    "pbt/properties.mbt": [ "and", "native", "wasm-gc" ],
    "pbt/shrinkers.mbt": [ "and", "native", "wasm-gc" ],
    "pbt/stateful.mbt": [ "and", "native", "wasm-gc" ],
    "pbt_compat.mbt": [ "native" ],
    "pbt_generated_test.mbt": [ "native" ],
  },
)
