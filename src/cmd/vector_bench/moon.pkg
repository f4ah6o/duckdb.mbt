// `encoding/utf8` is only reachable from `rss_native.mbt`, so the js build
// reports it as unused.
warnings = "-unused_package"

import {
  "f4ah6o/duckdb" @lib,
  "moonbitlang/core/bench",
  "moonbitlang/core/encoding/utf8" @encoding/utf8,
  "moonbitlang/core/env",
}

pkgtype(kind: "executable")

options(
  link: {
    "native": {
      "cc-link-flags": "-L/opt/homebrew/lib -Wl,-rpath,/opt/homebrew/lib -L/usr/local/lib -Wl,-rpath,/usr/local/lib -L/usr/lib -lduckdb",
    },
  },
  targets: {
    "rss_native.mbt": [ "native" ],
    "rss_stub.mbt": [ "or", "wasm", "wasm-gc", "js" ],
  },
)
